{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://property-playground.local/contracts/housing.schema.json",
  "title": "Property Playground housing contracts",
  "$defs": {
    "HousingFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "square_footage",
        "bedrooms",
        "bathrooms",
        "year_built",
        "lot_size",
        "distance_to_city_center",
        "school_rating"
      ],
      "properties": {
        "square_footage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "examples": [1550]
        },
        "bedrooms": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "examples": [3]
        },
        "bathrooms": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "examples": [2]
        },
        "year_built": {
          "type": "integer",
          "minimum": 1700,
          "maximum": 2200,
          "examples": [1997]
        },
        "lot_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "examples": [6800]
        },
        "distance_to_city_center": {
          "type": "number",
          "minimum": 0,
          "examples": [4.1]
        },
        "school_rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "examples": [7.6]
        }
      }
    },
    "PredictionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction"],
      "properties": {
        "prediction": {
          "type": "number",
          "description": "Predicted sale price in U.S. dollars (USD)."
        }
      }
    },
    "EstimateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction", "model"],
      "properties": {
        "prediction": {
          "type": "number",
          "description": "Predicted sale price in U.S. dollars (USD)."
        },
        "model": {
          "type": "string",
          "const": "housing-price-regression",
          "default": "housing-price-regression"
        }
      }
    }
  }
}
